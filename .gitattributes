# Source manifests and experiment signatures use canonical LF bytes.
*.csv text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Never normalize binary experiment inputs or artifacts.
*.npz -text
*.npy -text
*.pt -text
*.cool -text
*.gz -text
*.png -text
*.jpg -text
*.pdf -text
*.docx -text
*.pptx -text
