# Source manifests and experiment signatures use canonical LF bytes.
*.csv text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Never normalize binary experiment inputs or artifacts.
*.npz -text
*.npy -text
*.pt -text
*.cool -text
*.gz -text
*.png -text
*.jpg -text
*.pdf -text
*.docx -text
*.pptx -text

# Preserve exact archived artifact bytes, including Windows CSV newlines, for SHA checks.
results/method_review_v1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
results/targeted_review_v1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
results/evidence_review_v1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
results/classification_review_v1/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Captured stdout/stderr is immutable evidence, not source formatting input.
results/**/runs/*.log -whitespace
